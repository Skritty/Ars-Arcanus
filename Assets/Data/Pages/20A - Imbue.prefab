  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Imbuement is the essential opposite to Extraction, wherein mana is transported within a variable rune as opposed to being taken out from it. As such, mana moves not from rune to rune, but rather into the infinite beyond among the stars to be stored until needed. Trying to alter fundamental runes\u2013 such as attempting to imbue the Fire rune with Dark mana\u2013 will often simply lead to the destruction of the mana involved as it attempts to merge with or override something far more vast and is lost to the void. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
  m_sharedMaterial: {fileID: -3591927391524570855, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
