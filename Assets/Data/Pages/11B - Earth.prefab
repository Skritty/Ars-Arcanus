    - target: {fileID: 2127842040194719528, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_Name
      value: 11B - Earth
      objectReference: {fileID: 0}
    - target: {fileID: 4844587605343904853, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: "Earth is the last of the classical elements in the Natural Plane. It is the ground beneath your feet, the sand within your glass, the crystals that focus your tools. The sturdy end of the Axis of Matter is an element that resists change and lays a solid foundation to build upon, so long as no fractures are introduced to the system.\r\n\r\nWith this solidity, earth preserves all things, aiding in keeping mana contained and controlled in a great deal of processes, as well as stabilizing the Axis of Spirit within its crystalline structure. Too much earth-aligned mana, however, will steadily buckle under its own pressure and weight, causing cracks and breaks to appear in the runic structure and changing the underlying strokes of ink.\r\n\r\nThe Zodiac constellations commonly associated with Earth are Taurus the Bull, Virgo the Virgin, and Capricornus the Sea Goat. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5422127031761078480, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: The Element of Earth
      objectReference: {fileID: 0}
    - target: {fileID: 7818731809479512734, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
