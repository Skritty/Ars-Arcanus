    - target: {fileID: 1275779201814411523, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: "The <color=white>shadows</color> are cutting deeper\u2026 they wish to swallow me whole!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1275779201814411523, guid: aadb2b42a8950914787643598a4db751, type: 3}
