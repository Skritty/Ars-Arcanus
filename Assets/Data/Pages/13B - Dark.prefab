    - target: {fileID: 2127842040194719528, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_Name
      value: 13B - Dark
      objectReference: {fileID: 0}
    - target: {fileID: 3586159179928680928, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 475
      objectReference: {fileID: 0}
    - target: {fileID: 3586159179928680928, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_AnchoredPosition.y
      value: -345
      objectReference: {fileID: 0}
    - target: {fileID: 4844587605343904853, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: "Dark is the fundamental opposite of light, defined by its absence on the Axis of Spirit. It is the manifestation of the darkness between stars, that tenebrous field that encompasses all of creation. It pools like water, stabilizing not the natural elements, but the mysterious and transient void mana, slowing its decay. Of course, a shade must have a surface to give it shape and form, a task which earth is well-suited for.\r\n\r\nShadows are very good at concealing that which prefers to remain hidden, shrouding truth and falsehood alike beneath its veil. Should its shadows cut too deep, however, it turns its hunger towards nature itself, seeking to devour its energy like an insatiable black hole. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5422127031761078480, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: The Element of Dark
      objectReference: {fileID: 0}
    - target: {fileID: 7818731809479512734, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8577496753035159247, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
