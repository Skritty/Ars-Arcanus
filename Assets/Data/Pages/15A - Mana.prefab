  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Magic exists as an invisible energy-information substance (mana) that can be contained and used through runes. Runes \u2014 symbols contained within the spellbook and used by you \u2014 guide and modify the mana flowing through them, utilizing it to produce effects.\r\n\r\nIn the compilation structure, Mana serves as:\r\n\r\n- A universal data carrier and potential bridge between runic cells\r\n- A clock-cycle medium enabling real-time operation execution\r\n- A raw compilation resource capable of adopting any elemental vector property\r\n\r\nWarning: Uncontrolled mana supply without explicitly defined operators leads to memory leaks and invalid spell execution.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
  m_sharedMaterial: {fileID: -3591927391524570855, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
