    - target: {fileID: 1275779201814411523, guid: aadb2b42a8950914787643598a4db751, type: 3}
      propertyPath: m_text
      value: "This book\u2026 going back to these first pages, I can see where my intellect used to <color=white>shine</color>. I must get to the <color=white>bottom</color> of this\u2026 what is it doing to my mind?\r\n"
