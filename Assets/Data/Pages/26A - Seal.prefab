  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Seals are one specialized form of evocation runes. They use dark-aligned mana to seal both objects and information away behind an elemental lock. Examples can range between sealing a tool out of sight, to hiding pages of the Ars Arcanus itself, locking away information until the reader is ready to experience it. Knowledge in this spellbook is complex and dangerous, and so safeguards are in place to prevent improper handling. New seals may be drawn, but this can be dangerous, as it may lock pages away forever without proper setup.\r\r\n\nSeals are incredibly versatile and capable of endless layering for exponential complexity, but also lead to increasing difficulty for anyone trying to break it, including the creator of the seal. In addition, utilizing the geometry of the stars to create constellation key variables increases the strength of the seal by several orders of magnitude. \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
  m_sharedMaterial: {fileID: -3591927391524570855, guid: 0dbaabea45853494293403a1c4741dc3, type: 2}
